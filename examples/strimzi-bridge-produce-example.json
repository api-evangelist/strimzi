{
  "description": "Example of producing messages to a Kafka topic via the Strimzi Kafka Bridge REST API",
  "request": {
    "method": "POST",
    "url": "http://my-bridge.kafka.svc.cluster.local:8080/topics/orders",
    "headers": {
      "Content-Type": "application/vnd.kafka.json.v2+json"
    },
    "body": {
      "records": [
        {
          "key": "order-12345",
          "value": {
            "orderId": "12345",
            "customerId": "cust-789",
            "items": [
              {"productId": "prod-001", "quantity": 2, "price": 29.99}
            ],
            "total": 59.98,
            "status": "placed",
            "timestamp": "2026-05-02T10:00:00Z"
          },
          "headers": {
            "x-source": "order-service",
            "x-version": "v2"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "body": {
      "offsets": [
        {
          "partition": 2,
          "offset": 48392
        }
      ]
    }
  }
}
