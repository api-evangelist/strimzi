  "info": {
    "_postman_id": "8f290ff0-40ff-477f-8cb7-e9a6cca902bf",
    "name": "Strimzi Kafka Bridge REST Consumer Topics API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Strimzi Kafka Bridge provides an HTTP/REST interface to Apache Kafka. It allows HTTP clients to produce and consume messages, manage consumer group subscriptions, and query topic metadata without needing a native Kafka client library. The Bridge acts as a protocol translator between HTTP and the Kafka protocol. Deploy via the KafkaBridge custom resource.\n\nContact Support:\n Name: Strimzi Community",
      "type": "text/plain"
    }
  }
